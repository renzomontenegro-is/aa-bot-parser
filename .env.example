# Credenciales del Control Room de Automation Anywhere.
# Copia este archivo como .env y completa tus valores. El .env esta gitignoreado.

# URL del Control Room, sin barra al final
AA_CR_BASE=https://tu-control-room.automationanywhere.digital

# Usuario. Si tu Control Room usa dominio, va como  dominio\usuario
AA_CR_USER=tu_usuario

# API key: Control Room > My settings > Devices > API key
AA_CR_KEY=tu_api_key

# Workspace donde viven los bots: public (productivos) o private
AA_CR_WORKSPACE=public
